# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 캐시 수동 무효화 — /api/revalidate?secret=... 로 호출
REVALIDATE_SECRET=

# 배포 URL — OG 메타데이터 base URL (로컬: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 홈 태그 바 앞에 펼쳐 보일 코어 태그 (쉼표 구분, 적힌 순서대로 표시 — 비우면 코어 태그 없음)
# 빌드 시 값이 박히므로 Vercel에서 바꾼 뒤엔 재배포 필요
NEXT_PUBLIC_CORE_TAGS=백엔드,프론트엔드,인프라,데이터,AI,디자인,후기,회고,TIL

# Google Analytics (운영 환경에서만 설정, 로컬은 비워두면 비활성화)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
